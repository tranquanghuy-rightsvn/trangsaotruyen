# Code backend CMS (deploy qua clasp, KHONG track git - xem docs/CMS.md).
# Gitignore ngay tu dau du an theo gotcha #10 cua playbook, khong va lai sau.
gas/

# html/ la OUTPUT 100% cua scripts/build.py - xoa sach va sinh lai moi lan build.
# Nguon that: layouts/ (design) + static/ (CSS/JS/anh) + data/ (noi dung).
# KHONG sua file nao trong html/ - lan build ke tiep se xoa mat.
html/

.claude
excute.md
.DS_Store
# Dependency cua wrangler - cai lai bang `npm ci` (CI dung package-lock.json).
node_modules/

# Token dung chung giua Worker (secret ADMIN_TOKEN) va GAS (Script Property
# WORKER_API_TOKEN). Sinh cuc bo, KHONG BAO GIO commit. Xoa file sau khi da dan vao GAS.
ADMIN_TOKEN.txt
.dev.vars
